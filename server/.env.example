# --- Сервер ---
PORT=3001
# URL фронтенда (Vite dev server)
CLIENT_URL=http://localhost:5173
# Секрет для подписи сессий — замените на случайную длинную строку
SESSION_SECRET=change-me-to-a-long-random-string

# --- Discord OAuth ---
# Берётся из https://discord.com/developers/applications -> ваше приложение -> OAuth2
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Должен ТОЧНО совпадать с Redirect в настройках Discord-приложения
DISCORD_REDIRECT_URI=http://localhost:3001/api/auth/discord/callback

# --- Настройки, зависящие от игрового сервера ---
# Теперь меняются в админ-панели → Настройки и хранятся в server/data/site-settings.json.
# Значения ниже — только начальные (используются, пока настройки на сайте ни разу не сохраняли).
# SERVER_NAME=Senora
# FORUM_APPEALS_URL=https://forum.gta5rp.com/forums/obrashcheniya-v-prokuraturu.812/
# Cookie аккаунта, вошедшего на форум (разделы обращений закрыты для гостей).
# FORUM_COOKIE=
# URL вызова Yandex-функции уведомлений. Если пусто — уведомления не отправляются.
ASSIGN_NOTIFY_URL=
# Секрет, который шлётся в заголовке X-Auth-Token (должен совпадать с AUTH_TOKEN функции).
ASSIGN_NOTIFY_TOKEN=

# --- Доступ ---
# Суперпользователи (Discord ID через запятую): абсолютные права независимо от должности,
# их нельзя удалить. При первом входе на пустой базе суперпользователь становится министром.
ADMIN_DISCORD_IDS=

# --- Обход Cloudflare на форуме (FlareSolverr) ---
# Если задан — запросы к форуму (RSS и темы) идут через FlareSolverr.
# Пусто = прямой запрос (в проде без этого форум вернёт 403).
FLARESOLVERR_URL=http://localhost:8191/v1
